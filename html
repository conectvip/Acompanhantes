<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>VIP Club | Acesso Exclusivo</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        *, *::before, *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
            user-select: none;
        }

        :root {
            --primary: #ff007f;
            --primary-glow: rgba(255, 0, 127, 0.7);
            --secondary: #7900ff;
            --secondary-glow: rgba(121, 0, 255, 0.5);
            --accent: #00ffcc;
            --bg-dark: #040108;
        }

        html, body {
            width: 100%;
            height: 100%;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background: var(--bg-dark);
            color: #ffffff;
            overflow-x: hidden;
        }

        /* FUNDO DINÂMICO E LUZES NEON ANIMADAS */
        .ambient-bg {
            position: fixed;
            inset: 0;
            background: radial-gradient(circle at 50% 10%, rgba(121, 0, 255, 0.3), transparent 60%),
                        radial-gradient(circle at 80% 80%, rgba(255, 0, 127, 0.25), transparent 50%),
                        #040108;
            z-index: -2;
        }

        .light-orb {
            position: fixed;
            border-radius: 50%;
            filter: blur(90px);
            opacity: 0.75;
            pointer-events: none;
            z-index: -1;
            animation: orbFloat 7s infinite alternate ease-in-out;
        }

        .orb-1 {
            top: -120px;
            left: -60px;
            width: 320px;
            height: 320px;
            background: var(--primary);
        }

        .orb-2 {
            bottom: -120px;
            right: -60px;
            width: 380px;
            height: 380px;
            background: var(--secondary);
            animation-delay: -3.5s;
        }

        @keyframes orbFloat {
            0% { transform: translate(0, 0) scale(1); }
            100% { transform: translate(45px, 55px) scale(1.18); }
        }

        .container {
            width: 100%;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px 14px 100px 14px;
        }

        .main-card {
            width: 100%;
            max-width: 440px;
            text-align: center;
            position: relative;
        }

        /* BADGE NEON TOPO */
        .neon-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 22px;
            border-radius: 50px;
            background: rgba(255, 0, 127, 0.15);
            border: 1px solid var(--primary);
            font-size: 11px;
            font-weight: 900;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: #ff66d4;
            margin-bottom: 18px;
            box-shadow: 0 0 20px var(--primary-glow);
            animation: badgePulse 2s infinite alternate;
        }

        @keyframes badgePulse {
            0% { box-shadow: 0 0 10px rgba(255, 0, 127, 0.4); transform: scale(0.98); }
            100% { box-shadow: 0 0 28px rgba(255, 0, 127, 0.9); transform: scale(1.02); }
        }

        h1.title {
            font-size: clamp(26px, 6.5vw, 34px);
            font-weight: 900;
            line-height: 1.15;
            margin-bottom: 10px;
            background: linear-gradient(135deg, #ffffff 30%, #ff80df 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-transform: uppercase;
            letter-spacing: -0.5px;
        }

        p.subtitle {
            color: #cbbddf;
            font-size: 14px;
            font-weight: 600;
            line-height: 1.4;
            margin-bottom: 24px;
        }

        p.subtitle strong {
            color: #ff33b4;
            text-shadow: 0 0 10px var(--primary-glow);
        }

        /* JOGO INTERATIVO DA TESOURA */
        #gameArena {
            position: relative;
            width: 100%;
            height: 380px;
            border-radius: 30px;
            overflow: hidden;
            border: 1.5px solid rgba(255, 0, 127, 0.6);
            background: rgba(12, 4, 24, 0.7);
            backdrop-filter: blur(18px);
            box-shadow: 0 25px 50px rgba(0,0,0,0.85), inset 0 0 25px rgba(255,0,127,0.2);
            touch-action: none;
        }

        .target-box {
            position: absolute;
            left: 50%;
            top: 26%;
            width: 120px;
            height: 120px;
            transform: translate(-50%, -50%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 60px;
            border-radius: 28px;
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            border: 2px solid rgba(255, 255, 255, 0.9);
            box-shadow: 0 10px 35px var(--primary-glow);
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            z-index: 2;
        }

        .target-box::after {
            content: "";
            position: absolute;
            inset: -12px;
            border-radius: 36px;
            border: 2px dashed rgba(255, 102, 212, 0.85);
            animation: rotateDashed 12s linear infinite;
        }

        @keyframes rotateDashed {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .scissors-item {
            position: absolute;
            left: 50%;
            top: 75%;
            transform: translate(-50%, -50%);
            font-size: 72px;
            z-index: 10;
            cursor: grab;
            filter: drop-shadow(0 10px 20px rgba(0,0,0,0.9));
            transition: transform 0.1s ease, filter 0.2s ease;
            will-change: left, top;
        }

        .scissors-item.active {
            cursor: grabbing;
            filter: drop-shadow(0 15px 30px var(--primary-glow));
        }

        .instruction-bar {
            margin-top: 18px;
            font-size: 14px;
            font-weight: 700;
            color: #e5d9f6;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        /* MODAL DE CONFIRMAÇÃO */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(4, 1, 8, 0.96);
            backdrop-filter: blur(20px);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 1000;
            padding: 20px;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .modal-overlay.active {
            display: flex;
            opacity: 1;
        }

        .modal-box {
            background: linear-gradient(160deg, #23082e 0%, #08020f 100%);
            border: 1px solid rgba(255, 0, 127, 0.6);
            border-radius: 30px;
            padding: 32px 24px;
            width: 100%;
            max-width: 380px;
            text-align: center;
            box-shadow: 0 30px 70px rgba(0,0,0,0.95), 0 0 35px rgba(255,0,127,0.35);
            transform: translateY(20px) scale(0.95);
            transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .modal-overlay.active .modal-box {
            transform: translateY(0) scale(1);
        }

        .modal-box h3 {
            font-size: 22px;
            font-weight: 900;
            margin-bottom: 10px;
            color: #ffffff;
        }

        .modal-box p {
            font-size: 14px;
            color: #cbbddf;
            line-height: 1.5;
            margin-bottom: 24px;
        }

        .btn-group {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .btn-action {
            width: 100%;
            padding: 18px;
            border: none;
            border-radius: 18px;
            font-size: 16px;
            font-weight: 800;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-primary {
            background: linear-gradient(90deg, var(--primary) 0%, var(--secondary) 100%);
            color: #ffffff;
            box-shadow: 0 8px 25px var(--primary-glow);
        }

        .btn-secondary {
            background: rgba(255, 255, 255, 0.05);
            color: #a398b8;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        /* CONTEÚDO REVELADO */
        #vipContent {
            display: none;
            animation: fadeInUp 0.6s ease forwards;
            text-align: center;
        }

        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* BANNER COM EFEITO GLAMOUR E DESFOQUE NO RODAPÉ DA FOTO */
        .hero-banner {
            position: relative;
            width: 100%;
            height: 500px;
            border-radius: 30px;
            overflow: hidden;
            margin-bottom: 22px;
            border: 1.5px solid rgba(255, 0, 127, 0.65);
            box-shadow: 0 0 45px rgba(255, 0, 127, 0.45);
            background: #000;
        }

        .hero-banner img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center top;
            display: block;
        }

        .hero-fade-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(
                180deg, 
                rgba(4, 1, 8, 0) 30%, 
                rgba(4, 1, 8, 0.75) 70%, 
                #040108 100%
            );
            pointer-events: none;
        }

        .hero-info-tag {
            position: absolute;
            bottom: 22px;
            left: 20px;
            right: 20px;
            text-align: left;
            z-index: 3;
        }

        .status-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(0, 0, 0, 0.8);
            border: 1px solid var(--accent);
            color: var(--accent);
            font-size: 11px;
            font-weight: 900;
            padding: 6px 14px;
            border-radius: 20px;
            margin-bottom: 8px;
            backdrop-filter: blur(8px);
        }

        .status-dot {
            width: 7px;
            height: 7px;
            background: var(--accent);
            border-radius: 50%;
            box-shadow: 0 0 8px var(--accent);
            animation: blink 1.2s infinite alternate;
        }

        @keyframes blink {
            0% { opacity: 0.3; }
            100% { opacity: 1; }
        }

        .model-name-title {
            font-size: 26px;
            font-weight: 900;
            color: #fff;
            text-transform: uppercase;
            text-shadow: 0 2px 10px rgba(0,0,0,0.9);
        }

        .model-location-subtitle {
            font-size: 14px;
            color: #ff66d4;
            font-weight: 700;
        }

        /* BOTÃO TELEGRAM */
        .btn-telegram-main {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            width: 100%;
            padding: 20px;
            border-radius: 50px;
            background: linear-gradient(90deg, var(--primary) 0%, #0088cc 100%);
            color: #ffffff;
            font-size: 17px;
            font-weight: 900;
            text-decoration: none;
            letter-spacing: 0.5px;
            box-shadow: 0 0 32px rgba(255, 0, 127, 0.7);
            transition: transform 0.2s, box-shadow 0.2s;
            margin-bottom: 26px;
            animation: pulseCta 1.8s infinite alternate;
        }

        @keyframes pulseCta {
            0% { transform: scale(0.98); box-shadow: 0 0 16px rgba(255, 0, 127, 0.4); }
            100% { transform: scale(1.02); box-shadow: 0 0 38px rgba(0, 136, 204, 0.85); }
        }

        .btn-telegram-main:active { transform: scale(0.96); }

        .section-title {
            text-align: left;
            font-size: 15px;
            font-weight: 900;
            color: #ff66d4;
            margin: 28px 0 16px 0;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* AVALIAÇÕES */
        .reviews-container {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-bottom: 25px;
        }

        .review-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 0, 127, 0.25);
            border-radius: 20px;
            padding: 16px;
            text-align: left;
            backdrop-filter: blur(8px);
        }

        .review-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 8px;
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--primary);
        }

        .user-name {
            font-size: 14px;
            font-weight: 800;
            color: #fff;
        }

        .rating-badge {
            font-size: 13px;
            font-weight: 800;
            color: #ffb700;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .rating-stars {
            color: #ffb700;
            font-size: 12px;
        }

        .review-text {
            font-size: 13px;
            color: #d1c4e9;
            line-height: 1.4;
            font-style: italic;
        }

        /* BARRA FIXA */
        .sticky-bar {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            padding: 12px 16px;
            background: rgba(4, 1, 8, 0.92);
            backdrop-filter: blur(14px);
            border-top: 1px solid rgba(255, 0, 127, 0.35);
            z-index: 90;
            display: none;
            justify-content: center;
        }

        .sticky-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            width: 100%;
            max-width: 440px;
            padding: 16px;
            border-radius: 50px;
            background: linear-gradient(90deg, var(--primary) 0%, #0088cc 100%);
            color: #ffffff;
            font-size: 16px;
            font-weight: 900;
            text-decoration: none;
            letter-spacing: 0.5px;
            box-shadow: 0 0 25px rgba(255, 0, 127, 0.6);
            animation: pulseCta 1.8s infinite alternate;
        }

        .confetti-piece {
            position: fixed;
            width: 8px;
            height: 12px;
            border-radius: 2px;
            pointer-events: none;
            z-index: 9999;
            animation: confettiFall 2.5s linear forwards;
        }

        @keyframes confettiFall {
            from { transform: translateY(-20px) rotate(0deg); opacity: 1; }
            to { transform: translateY(105vh) rotate(720deg); opacity: 0; }
        }
    </style>
</head>
<body>

