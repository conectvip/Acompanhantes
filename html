<script>
    const scissorsBtn = document.getElementById("scissorsBtn");
    const targetBox = document.getElementById("targetBox");
    const gameArena = document.getElementById("gameArena");
    const instructionText = document.getElementById("instructionText");
    const gameScreen = document.getElementById("gameScreen");
    const vipContent = document.getElementById("vipContent");
    const ageModal = document.getElementById("ageModal");
    const btnYes = document.getElementById("btnYes");
    const btnNo = document.getElementById("btnNo");
    const stickyCta = document.getElementById("stickyCta");

    let isDragging = false;
    let isFinished = false;

    function startDrag(e) {
        if (isFinished) return;
        isDragging = true;
        scissorsBtn.classList.add("active");
        instructionText.textContent = "⚡ Arraste e corte o laço!";
        moveAt(e);
    }

    function moveAt(e) {
        if (!isDragging || isFinished) return;

        const arenaRect = gameArena.getBoundingClientRect();
        
        let clientX = e.clientX;
        let clientY = e.clientY;

        if (e.touches && e.touches.length > 0) {
            clientX = e.touches[0].clientX;
            clientY = e.touches[0].clientY;
        }

        let newX = clientX - arenaRect.left;
        let newY = clientY - arenaRect.top;

        const padding = 35;
        newX = Math.max(padding, Math.min(arenaRect.width - padding, newX));
        newY = Math.max(padding, Math.min(arenaRect.height - padding, newY));

        scissorsBtn.style.left = newX + "px";
        scissorsBtn.style.top = newY + "px";

        detectCollision();
    }

    function stopDrag() {
        if (isFinished) return;
        isDragging = false;
        scissorsBtn.classList.remove("active");
        
        scissorsBtn.style.left = "50%";
        scissorsBtn.style.top = "75%";
    }

    function detectCollision() {
        const sRect = scissorsBtn.getBoundingClientRect();
        const tRect = targetBox.getBoundingClientRect();

        const collisionMargin = 15;

        const hit = !(
            sRect.right - collisionMargin < tRect.left ||
            sRect.left + collisionMargin > tRect.right ||
            sRect.bottom - collisionMargin < tRect.top ||
            sRect.top + collisionMargin > tRect.bottom
        );

        if (hit) {
            triggerWin();
        }
    }

    function triggerWin() {
        isFinished = true;
        isDragging = false;
        scissorsBtn.classList.remove("active");

        targetBox.textContent = "💖";
        targetBox.style.background = "#ffffff";
        targetBox.style.boxShadow = "0 0 50px #ff007f";
        targetBox.style.transform = "translate(-50%, -50%) scale(1.2)";

        if (navigator.vibrate) navigator.vibrate([80, 40, 100]);

        setTimeout(() => {
            ageModal.classList.add("active");
        }, 400);
    }

    scissorsBtn.addEventListener("mousedown", startDrag);
    window.addEventListener("mousemove", moveAt);
    window.addEventListener("mouseup", stopDrag);

    scissorsBtn.addEventListener("touchstart", startDrag, { passive: false });
    window.addEventListener("touchmove", moveAt, { passive: false });
    window.addEventListener("touchend", stopDrag);

    btnYes.addEventListener("click", () => {
        ageModal.classList.remove("active");
        gameScreen.style.display = "none";
        vipContent.style.display = "block";
        stickyCta.style.display = "flex";
        launchConfetti();
    });

    btnNo.addEventListener("click", () => {
        window.location.href = "https://www.google.com";
    });

    function launchConfetti() {
        const colors = ["#ff007f", "#7900ff", "#00ffcc", "#ffffff"];
        for (let i = 0; i < 50; i++) {
            const confetti = document.createElement("div");
            confetti.className = "confetti-piece";
            confetti.style.left = Math.random() * 100 + "vw";
            confetti.style.top = (-10 - Math.random() * 20) + "px";
            confetti.style.background = colors[Math.floor(Math.random() * colors.length)];
            confetti.style.animationDuration = (1.8 + Math.random() * 1.5) + "s";
            document.body.appendChild(confetti);

            setTimeout(() => confetti.remove(), 3500);
        }
    }
</script>

</body>
</html>

